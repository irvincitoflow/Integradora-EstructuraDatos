<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Car Wash</title>
    <link rel="stylesheet" href="css/CSSPantallaInicio.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>

<header class="navbar">
    <div class="user-info">
        <i class="bi bi-person-circle avatar-icon"></i>
        <span>Usuario</span>
    </div>
    <button class="btn-logout">Cerrar Sesion <i class="bi bi-box-arrow-right ms-1"></i></button>
</header>

<main class="main-content">
    <div class="card">
        <h1>¡Bienvenido a tu Car Wash!</h1>
        <h2>¿Qué deseas hacer hoy?</h2>

        <div class="card-buttons">
            <button class="btn-action">Buscar tarjeta</button>
            <button class="btn-action">Registrar venta</button>
        </div>
    </div>
</main>

</body>
</html>